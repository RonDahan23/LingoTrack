# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development
PORT=3000

# PostgreSQL. In production this is injected by Railway's Postgres plugin
# (reference ${{Postgres.DATABASE_URL}}). For local dev, point it at a local
# Postgres or reuse the Railway database URL. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lingotrack?schema=public"

# https://developer.spotify.com/dashboard — the redirect URI must match the
# value registered there byte for byte. Spotify rejects "localhost"; use
# 127.0.0.1 for loopback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# 32 bytes of hex, encrypts Spotify tokens at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every stored token and forces users to re-link.
TOKEN_ENCRYPTION_KEY=

# Signs OAuth state and client session tokens (>= 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=720

# Origin of the React (Vite) web app. The callback redirects the browser here
# with ?token= after login, and it's the allowed CORS origin for the SPA's API
# calls. This app's dev server runs on port 5199. Bare origin — no trailing
# slash.
WEB_APP_URL=http://localhost:5199
